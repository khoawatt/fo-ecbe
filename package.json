{
  "name": "fo-ecbe",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"{src,test}/**/*.ts\" \"*.{json,md}\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\" \"*.{json,md}\"",
    "test": "npm run test:unit",
    "test:unit": "jest --config jest.unit.config.js --passWithNoTests",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "test:e2e": "jest --config jest.e2e.config.js --runInBand",
    "typeorm": "typeorm-ts-node-commonjs -d src/database/typeorm/data-source.ts",
    "migration:show": "npm run typeorm -- migration:show",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "ci": "npm run lint && npm run format:check && npm run test:unit && npm run test:integration && npm run test:e2e && npm run build"
  },
  "dependencies": {
    "@nestjs/common": "^9.4.3",
    "@nestjs/config": "^2.3.4",
    "@nestjs/core": "^9.4.3",
    "@nestjs/platform-express": "^9.4.3",
    "@nestjs/typeorm": "^9.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.4.7",
    "joi": "^17.13.3",
    "pg": "^8.14.1",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.22"
  },
  "devDependencies": {
    "@nestjs/cli": "^9.5.0",
    "@nestjs/testing": "^9.4.3",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^18.19.0",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.0",
    "jest": "^29.7.0",
    "prettier": "^2.8.8",
    "supertest": "^6.3.4",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^4.9.5"
  }
}
